{
  "name": "karli-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/database.mjs check",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database.mjs migrate",
    "db:admin": "node --env-file-if-exists=.env.local scripts/database.mjs admin"
  },
  "dependencies": {
    "mysql2": "^3.15.0"
  }
}

